# Copy values into Vercel Project Settings > Environment Variables.
# Never commit real secrets. Keep all credentials server-side (no NEXT_PUBLIC_ prefix).

ALIEXPRESS_APP_KEY=5539608
ALIEXPRESS_APP_SECRET=replace_with_secret_from_aliexpress_open_platform

# Vercel Blob persistent catalog storage. Create a Blob store in the Vercel project and add its read/write token.
BLOB_READ_WRITE_TOKEN=replace_with_vercel_blob_read_write_token

STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_signing_secret

# Keep both gates disabled until legal review and supplier order fulfillment are proven end-to-end.
CHECKOUT_ENABLED=false
COMMERCE_RELEASE_APPROVED=false

# Must be a real HTTPS supplier-order adapter; this is NOT an AliExpress affiliate API URL.
SUPPLIER_ORDER_FULFILLMENT_URL=
SUPPLIER_ORDER_FULFILLMENT_TOKEN=

# Protects scheduled jobs and the simulation endpoint; set a long random secret in Vercel.
CRON_SECRET=replace_with_a_long_random_secret

# Simulation endpoint is disabled by default. Enable only in a non-production/test deployment.
COMMERCE_SIMULATION_ENABLED=false

# Optional canonical production URL.
NEXT_PUBLIC_SITE_URL=https://nexorao-vip-store.vercel.app
