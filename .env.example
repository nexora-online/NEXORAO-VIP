# Template only. Copy the required variables into Vercel Project Settings > Environment Variables.
# Never commit real secrets. Do not use NEXT_PUBLIC_ for private keys/tokens.
# Empty supplier credentials intentionally select the clearly labeled simulation catalog.

# Live AliExpress Affiliate API (leave empty until real credentials are issued)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Persistent catalog storage. Create a Vercel Blob store and connect its read/write token.
# Without this token, sync results cannot survive server restarts.
BLOB_READ_WRITE_TOKEN=

# Payment credentials are not sufficient to enable checkout; both release gates must be true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
COMMERCE_RELEASE_APPROVED=false

# Must be a real HTTPS supplier-order adapter; AliExpress Affiliate API is not fulfillment.
SUPPLIER_ORDER_FULFILLMENT_URL=
SUPPLIER_ORDER_FULFILLMENT_TOKEN=

# Long random secret for protected scheduled tasks/simulation endpoints.
CRON_SECRET=

# Disabled by default. Only enable in a non-production/test deployment.
COMMERCE_SIMULATION_ENABLED=false

# Optional canonical production URL.
NEXT_PUBLIC_SITE_URL=https://nexorao-vip-store.vercel.app
